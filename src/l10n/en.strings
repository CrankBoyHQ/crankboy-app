"setdsc_manage_rom" = "View ROM info and delete the ROM, save data, or cover art.";
"setdsc_patches_hacks" = "Manage and download game patches, also known as ROM hacks.\n\nRemember to verify that a hack is compatible with your ROM before applying it.\n\nParental lock is available.";
"setdsc_save_data" = "Select which save file to use for the ROM's internal save data.\n\nIf you apply softpatches, you may wish to use different saves for each.\n\nNote: \"save states\" are a different concept.";
"setdsc_save_data_disabled" = "Because this ROM does not use internal save data, this feature is disabled.";
"setdsc_settings_scope_game" = "Use shared settings or create custom ones for this game.\n\nGlobal:\nSettings are shared across all games.\n\nGame:\nSettings are unique to this game.";
"setdsc_settings_scope_library" = "Which settings to edit.\n\nGlobal:\nEdit app-wide settings, including Library options.\n\nGame:\nEdit settings specific for the selected game.";
"setdsc_apply_recommended" = "Recommended settings can be applied from the settings menu at any time.";
"setdsc_apply_recommended_done" = "Recommended settings are already applied.";
"setdsc_apply_recommended_scope" = "Switch to 'Game' scope to apply recommended settings.";
"setdsc_apply_recommended_apply" = "Apply the recommended settings for this game.";
"setdsc_just_now" = "just now";
"setdsc_save_snapshot_just_now" = "Overwrite snapshot from\njust now.";
"setdsc_load_snapshot_just_now" = "Restore snapshot from\njust now.";
"setdsc_save_snapshot_ago" = "Overwrite snapshot from\n%s ago.";
"setdsc_load_snapshot_ago" = "Restore snapshot from\n%s ago.";
"setdsc_disabled_by_script" = "Disabled by game script.";
"setdsc_sound_mode" = "Fast:\nGood performance. Sound timing is less precise.\n\nAccurate:\nMost faithful audio. Uses a buffer to ensure correct sound pitch and speed.\nMinor performance cost.";
"setdsc_sample_rate_accurate" = "Accurate sound mode requires High sample rate.";
"setdsc_sample_rate" = "Adjusts audio quality.\nHigher values may impact performance.\n\nHigh:\nBest quality (44.1 kHz)\n\nMedium:\nGood quality (22.1 kHz)\n\nLow:\nReduced quality (14.7 kHz)";
"setdsc_high_pass_filter" = "Emulates the hardware's capacitor coupling. Bass frequencies are weakend.\n\nOn:\nHardware-accurate sound. Costs a little performance.\n\nOff:\nFuller bass, but less faithful to the original hardware.";
"setdsc_headphones" = "Select the audio output mode when an aux cable is connected.\n\nStereo:\nImmersive sound with spatial separation.\n\nMono:\n Combines channels, which improves performance.\n\nAlso used for Mirror.";
"setdsc_framerate" = "Set the display framerate.\n\n30FPS: displays every second frame. Best performance.\n\n50FPS: displays 5 of every 6 frames. Fastest reliable full refresh.\n\n60FPS: displays every frame.";
"setdsc_frame_blending" = "Blends two consecutive frames with dithering to reproduce the Game Boy's flicker-based transparency effects.";
"setdsc_frame_blending_30fps_only" = "Blends two consecutive frames with dithering to reproduce the Game Boy's flicker-based transparency effects.\n\nOnly needed at 30FPS.";
"setdsc_lcd_ghosting" = "Mimics the DMG LCD's slow pixel response, smearing motion over 100 ms.\n\nOnly available in DMG Mode.";
"setdsc_dither" = "How to represent 4-color graphics on a 1-bit display.\n\nL: bias toward light\n\nD: bias toward dark";
"setdsc_first_scaling_line" = "Due to the 3:5 ratio between the GB's and Playdate's vertical resolutions, 1 in every 3 scanlines must be vertically squished.\n\nThis means there are three choices for which lines are to be the ones to squish.If text is uneven, try adjusting this.";
"setdsc_stabilization" = "Stabilizes scaling artifacts by making them scroll with the camera.\n\nThis prevents textures from shimmering, but may reduce performance slightly in scroll-heavy games.\n\nWorks best with Dither set to \"Staggered\".";
"setdsc_crank" = "Start/Select mode.\n\nTurn the crank back to press Select.\n\nTurn forward to press Start.\n\nSee 'Down' for crank-down action.";
"setdsc_crank_turbo_ab" = "Turbo A/B mode.\n\nCW = turbo-press A.\nCCW = turbo-press B.";
"setdsc_crank_turbo_ba" = "Turbo B/A mode.\n\nCW = turbo-press B.\nCCW = turbo-press A.";
"setdsc_crank_none" = "Assign a function to the crank.\n\nCurrently: no function.";
"setdsc_crank_down" = "Only available when Crank mode is set to Start/Select.";
"setdsc_crank_down_active" = "When the crank is pointed down (between Start and Select), choose whether to hold Start + Select or do nothing.";
"setdsc_undock" = "Assign a button input for undocking the crank.\n\n";
"setdsc_dock" = "Assign a button input for docking the crank.\n\n";
"setdsc_menu" = "Quickly open and close the system menu to trigger a button press.\n\nOpen and close within one second to activate.";
"setdsc_a_to_menu" = "Assign a replacement button input for holding Ⓐ and then pressing Ⓑ.\n\nThis replaces the normal button presses.";
"setdsc_b_to_menu" = "Assign a replacement button input for holding Ⓑ and then pressing Ⓐ.\n\nThis replaces the normal button presses.";
"setdsc_b_plus_a" = "Assign a replacement button input when simultaneously pressing both Ⓐ and Ⓑ.\n\nThis replaces the normal button presses.\n\nNote: both buttons must be pressed on exactly the same frame, which is quite precise!";
"setdsc_menu_to_a" = "Assign a replacement button input for holding both Ⓐ and Ⓑ then releasing Ⓑ.\n\nIf A is omitted here, then the A input is suppressed until next released.\n\nDefault: maps to A normally, but to None if Ⓑ+Ⓐ triggered a combo input (see settings above)";
"setdsc_menu_to_b" = "Assign a replacement button input for holding Ⓐ and Ⓑ then releasing Ⓐ (or both simultaneously).\n\nIf B is omitted here, then the B input is suppressed until next released.\n\nDefault: maps to B normally, but to None if Ⓑ+Ⓐ triggered a combo input (see settings above)";
"setdsc_lock_override" = "Playdate's lock button can be used for start or select.\n\nRequires system access\n(i.e. launch CrankBoy via FunnyLoader)\n\nOnly applies input from the moment the lock button is pressed; holding the lock button has no effect.";
"setdsc_cpu_speed" = "Normally, the CGB CPU can run twice as fast as the DMG (non-Color GB).\n\nSet to \"DMG\" to force it to run at DMG speed.\n\nCan greatly improve perf on titles which don't make efficient use of the CPU.\n\nThis is the opposite of overclocking.";
"setdsc_hle_routines" = "Automatically identify certain common routines and replace them with high-level emulated versions.\n\nCan allow for large performance gains, but potentially inaccurate.";
"setdsc_gray_mode" = "How the CGB grayscale conversion is tuned.\n\nManual: set the grayscale bias yourself.\n\nAuto: picks the best of Dark/Neutral/Bright for each scene.\n\nContrast: normalizes contrast to the \"colors\" actually on screen.";
"setdsc_grayscale_bias" = "Manually shift CGB grayscale conversion between 5 levels, from darker to brighter shades.\n\nOnly available in Manual mode.";
"setdsc_grayscale_bias_manual" = "Manually shift CGB grayscale conversion between 5 levels, from darker to brighter shades.";
"setdsc_cgb_gamma" = "Adjusts the perceptual gamma of the CGB grayscale conversion.\n\nHigher values brighten dark areas at the cost of highlights. Lower values darken the image.";
"setdsc_rewind" = "Rewind up to 10 seconds of gameplay.\n\nHold Ⓑ or Up and undock the crank to enter rewind.\n\nHold Ⓑ or Up while cranking to scrub.\n\nRelease Ⓑ or Up then dock the crank to exit.\n\nDMG only.";
"setdsc_overclock" = "Runs the emulated CPU faster between frames to reduce in-game lag.\n\nThe Playdate must work harder, so results vary and timing may be less accurate.\n\nOn Game Boy Color at double speed, x4 is limited to x2.";
"setdsc_overclock_catalog" = "Runs the emulated CPU faster between frames to reduce in-game lag.\n\nThe Playdate must work harder, so results vary and timing may be less accurate.\n\nIn CGB double-speed mode, x4 is limited to x2.";
"setdsc_game_scripts" = "Scripts attempt to add Playdate feature support into ROMs.\n\nFor instance, the crank might be used to navigate menus.";
"setdsc_game_scripts_per_game" = "\n\nThis setting is always per-game.";
"setdsc_game_scripts_hold_button" = "\n\nHold the Ⓐ button now for more information.";
"setdsc_game_scripts_hold_restart" = "\n\nHold the Ⓐ button now for more information.\n\nRestart the ROM for this setting to take effect.";
"setdsc_game_scripts_restart" = "\n\nRestart the ROM for this setting to take effect.";
"setdsc_game_scripts_none" = "\n\nThere is no script available for this ROM.";
"setdsc_title_display" = "Choose how game titlesare displayed in the list.\n\nShort:\nThe common game title\n(by database match).\n\nDetailed:\nThe full title, including region and version info.\n\nFilename:\nThe original ROM filename.\n\n";
"setdsc_article" = "If a game title ends with an article, such as\n\n      \"Mummy, The (USA)\"\n\nit can be displayed at the start instead, i.e.\n\n      \"The Mummy (USA)\"";
"setdsc_sort" = "Sort the games list either by database name or by filename.\n\nCan also choose to include articles that have been moved to the front of the name toward sorting.";
"setdsc_remember_last" = "When opening the library, initial selection will be the last game played.";
"setdsc_launch_animation" = "Animation when launching a ROM from the library.";
"setdsc_cgb_prompt" = "When launching a ROM, show a prompt to choose:\n\n1. DMG (original) emulation\n2. CGB (\"Color\") emulation\n\nNo: never prompt\nYes: CGB-compatible ROMs\nAlways: CGB and DMG ROMs\n\nCGB-only ROMs always show a one-time notice.";
"setdsc_bundled_games" = "Show or hide games that are bundled with CrankBoy in the library.\n\nRequires restart to apply.";
"setdsc_show_fps" = "Displays the current frames-per-second on screen.\n\nChoice of displaying Playdate screen refreshes or emulated frames. (These can differ if 30 FPS mode is enabled.)\n\nIdeal performance is just under 60 emulated frames per second.";
"setdsc_turbo_speed" = "Removes the FPS limit.\n\nThis is intended just for benchmarking performance, not for casual play.";
"setdsc_disable_auto_lock" = "Prevents the device from auto-locking after 3 minutes of inactivity.\n\nNote: This only applies while a game is running.";
"setdsc_boot_fade" = "Fade from black/white on game start. Masks visual glitches.\n\nThe options marked (W) fade from white.";
"setdsc_boot_fade_bundled" = "Fade from black on game start.\n\nIn bundled mode, fade from white is not currently possible.";
"setdsc_tcm_mode" = "Runs emulator in TCM for better performance.\n\nFull: core + draw.\nCore: interpreter only.\nDraw: rendering only.\n\nDisable (or restrict) if you experience instability.";
"setdsc_tcm_mode_restart" = "%s\n\nRestart the game for changes to apply.\n\n%s";
"setdsc_tcm_device" = "(Your device: %s)";
"setdsc_lcd_acceleration" = "Provides minor perf boost by using the Playdate's own last-frame buffer to store the GB's internal frame buffer as well.\n\nSometimes causes garbage data to become visible on screen.";
"setdsc_about_crankboy" = "This game is bundled for Playdate via CrankBoy, a Game Boy emulator.\n\nPress Ⓐ now to learn more about CrankBoy and its developers.";

